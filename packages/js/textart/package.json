{
  "name": "anbani-textart",
  "version": "1.8.1",
  "description": "Text Art Generator by Anbani.ge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anbani/anbani.git",
    "directory": "packages/js/textart"
  },
  "homepage": "https://anbani.ge/textart",
  "bugs": "https://github.com/Anbani/anbani/issues",
  "module": "src/TextArt.mjs",
  "main": "dist/TextArt.js",
  "files": [
